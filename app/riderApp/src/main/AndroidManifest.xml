<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/rider_ic_launcher"
        android:label="@string/rider_app_name"
        android:roundIcon="@mipmap/rider_ic_launcher_round"
        android:theme="@style/Taxibou.Rider.SplashTheme">
        <activity
            android:name=".RiderMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>